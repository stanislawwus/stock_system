# The Docker demo (`make up`) needs none of these values: it runs on data/demo without keys.
# Copy to .env and fill in. .env is git-ignored; never commit real keys.
OPENROUTER_API_KEY=
FINNHUB_API_KEY=
# SEC EDGAR requires a descriptive User-Agent with a contact e-mail, e.g.
#   SEC_USER_AGENT=stock-awareness-assistant your.name@your-domain
# src/collectors/edgar.py refuses to call SEC without it.
SEC_USER_AGENT=
# Base URL the Streamlit client uses to reach the API (docker-compose sets http://api:8000/api/v1)
API_URL=http://127.0.0.1:8000/api/v1
# Optional overrides (defaults live in config/*.yaml)
# LLM_DAILY_BUDGET=200
# DUCKDB_PATH=data/stock.duckdb
