{
  "openapi": "3.1.0",
  "info": {
    "title": "Stock Awareness Assistant",
    "description": "News + SEC filings -> sentiment/events -> impact -> strategy arena -> simulator -> chat with citations. Every output is a simulation, not investment advice.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/watchlist": {
      "get": {
        "tags": [
          "watchlist"
        ],
        "summary": "Configured watchlist and benchmark",
        "operationId": "get_watchlist_api_v1_watchlist_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Watchlist"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/brief": {
      "get": {
        "tags": [
          "brief"
        ],
        "summary": "Morning brief for the watchlist as of day D",
        "operationId": "get_brief_api_v1_brief_get",
        "parameters": [
          {
            "name": "day",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "trading day D; default: today",
              "title": "Day"
            },
            "description": "trading day D; default: today"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Brief"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/signals": {
      "get": {
        "tags": [
          "signals"
        ],
        "summary": "Every strategy's signal for a ticker as of the 09:00 ET cutoff of day D",
        "operationId": "get_signals_api_v1_signals_get",
        "parameters": [
          {
            "name": "ticker",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10,
              "title": "Ticker"
            }
          },
          {
            "name": "as_of",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "trading day D (cutoff 09:00 ET of D) or a tz-aware instant; default: the last validation day",
              "title": "As Of"
            },
            "description": "trading day D (cutoff 09:00 ET of D) or a tz-aware instant; default: the last validation day"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignalsResponse"
                }
              }
            }
          },
          "403": {
            "description": "as_of is in the test period (AGENTS.md R3)"
          },
          "404": {
            "description": "ticker not in the universe"
          },
          "503": {
            "description": "database missing, or busy while make features/collect writes"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/events/{ticker}": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "8-K filings with event labels and extracted facts",
        "operationId": "get_events_api_v1_events__ticker__get",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ticker"
            }
          },
          {
            "name": "lookback_days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 400,
              "minimum": 1,
              "default": 90,
              "title": "Lookback Days"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/evals": {
      "get": {
        "tags": [
          "evals"
        ],
        "summary": "Latest eval result per component",
        "operationId": "get_evals_api_v1_evals_get",
        "parameters": [
          {
            "name": "component",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "e.g. backtest_finbert_v0_validation",
              "title": "Component"
            },
            "description": "e.g. backtest_finbert_v0_validation"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EvalResult"
                  },
                  "title": "Response Get Evals Api V1 Evals Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/models": {
      "get": {
        "tags": [
          "models"
        ],
        "summary": "Configured free models and budget use",
        "operationId": "get_models_api_v1_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ModelInfo"
                  },
                  "type": "array",
                  "title": "Response Get Models Api V1 Models Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analyze": {
      "post": {
        "tags": [
          "nlp"
        ],
        "summary": "Arbitrary text -> sentiment (events later)",
        "operationId": "post_analyze_api_v1_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/collect": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Start data collection for the given periods (background job)",
        "operationId": "post_collect_api_v1_collect_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CollectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobAccepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/arena": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Run every strategy on a split and refresh the leaderboard (background job)",
        "operationId": "post_arena_api_v1_arena_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArenaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobAccepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Status and result of a job",
        "operationId": "get_job_api_v1_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatus"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Question -> answer from read-only tools with numbered citations (no LLM in the path)",
        "description": "Refusals (unknown ticker, guaranteed profit, test period) are 200 with `refused=true`.",
        "operationId": "post_chat_api_v1_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "503": {
            "description": "database missing, or busy while a writer holds it"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Liveness, also under the API prefix",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api V1 Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Text"
          },
          "ticker": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ticker"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "AnalyzeRequest"
      },
      "AnalyzeResponse": {
        "properties": {
          "sentiment": {
            "$ref": "#/components/schemas/Sentiment"
          },
          "events": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Event"
              },
              {
                "type": "null"
              }
            ],
            "description": "None until the event classifier exists"
          },
          "facts": {
            "items": {
              "$ref": "#/components/schemas/Fact"
            },
            "type": "array",
            "title": "Facts"
          },
          "method": {
            "type": "string",
            "enum": [
              "llm",
              "rules",
              "lexicon",
              "finbert",
              "index",
              "xbrl",
              "regex",
              "model"
            ],
            "title": "Method"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer",
            "default": "This is a simulation, not investment advice."
          }
        },
        "type": "object",
        "required": [
          "sentiment",
          "facts",
          "method"
        ],
        "title": "AnalyzeResponse"
      },
      "ArenaRequest": {
        "properties": {
          "split": {
            "type": "string",
            "enum": [
              "train",
              "validation"
            ],
            "title": "Split"
          }
        },
        "type": "object",
        "required": [
          "split"
        ],
        "title": "ArenaRequest"
      },
      "Brief": {
        "properties": {
          "as_of": {
            "type": "string",
            "format": "date-time",
            "title": "As Of"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/BriefItem"
            },
            "type": "array",
            "title": "Items"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer",
            "default": "This is a simulation, not investment advice."
          }
        },
        "type": "object",
        "required": [
          "as_of",
          "items"
        ],
        "title": "Brief"
      },
      "BriefItem": {
        "properties": {
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "last_close": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Close"
          },
          "change_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Change Pct"
          },
          "sentiment_index": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sentiment Index"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "type": "array",
            "title": "Events"
          },
          "signal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Signal"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "ticker",
          "last_close",
          "change_pct",
          "sentiment_index"
        ],
        "title": "BriefItem"
      },
      "ChatRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "description": "e.g. 'Why did AAPL move on 2026-07-15?'"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "method": {
            "type": "string",
            "enum": [
              "llm",
              "rules",
              "lexicon",
              "finbert",
              "index",
              "xbrl",
              "regex",
              "model"
            ],
            "title": "Method",
            "description": "rules = template composer; llm = cached rephrase (D-46)"
          },
          "intent": {
            "type": "string",
            "enum": [
              "why_move",
              "price",
              "news",
              "signals",
              "backtest",
              "refuse"
            ],
            "title": "Intent"
          },
          "ticker": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ticker"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "tools_used": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tools Used",
            "description": "tool plan, in call order"
          },
          "refused": {
            "type": "boolean",
            "title": "Refused",
            "default": false
          },
          "refusal_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refusal Reason"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer",
            "default": "This is a simulation, not investment advice."
          }
        },
        "type": "object",
        "required": [
          "answer",
          "citations",
          "method",
          "intent"
        ],
        "title": "ChatResponse"
      },
      "Citation": {
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 0.0,
            "title": "N",
            "description": "the [n] marker in the answer text (chat)",
            "default": 0
          },
          "source_ref": {
            "type": "string",
            "title": "Source Ref",
            "description": "news id, 8-K accession number, or fact/price ref"
          },
          "kind": {
            "type": "string",
            "enum": [
              "news",
              "filing",
              "fact",
              "price"
            ],
            "title": "Kind"
          },
          "ticker": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ticker"
          },
          "available_at": {
            "type": "string",
            "format": "date-time",
            "title": "Available At"
          },
          "quote": {
            "type": "string",
            "title": "Quote"
          }
        },
        "type": "object",
        "required": [
          "source_ref",
          "kind",
          "available_at",
          "quote"
        ],
        "title": "Citation"
      },
      "CollectRequest": {
        "properties": {
          "periods": {
            "items": {
              "type": "string",
              "enum": [
                "warmup",
                "train",
                "validation",
                "test"
              ]
            },
            "type": "array",
            "title": "Periods"
          }
        },
        "type": "object",
        "required": [
          "periods"
        ],
        "title": "CollectRequest"
      },
      "EvalResult": {
        "properties": {
          "component": {
            "type": "string",
            "title": "Component"
          },
          "metric": {
            "type": "string",
            "title": "Metric"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "target": {
            "type": "number",
            "title": "Target"
          },
          "why_this_metric": {
            "type": "string",
            "title": "Why This Metric"
          },
          "gold_set": {
            "type": "string",
            "title": "Gold Set"
          },
          "n": {
            "type": "integer",
            "title": "N"
          },
          "split": {
            "type": "string",
            "title": "Split"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "git_sha": {
            "type": "string",
            "title": "Git Sha"
          },
          "run_at": {
            "type": "string",
            "format": "date-time",
            "title": "Run At"
          },
          "notes": {
            "type": "string",
            "title": "Notes",
            "default": ""
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details",
            "description": "component-specific extras"
          }
        },
        "type": "object",
        "required": [
          "component",
          "metric",
          "value",
          "target",
          "why_this_metric",
          "gold_set",
          "n",
          "split",
          "model",
          "git_sha",
          "run_at"
        ],
        "title": "EvalResult",
        "description": "Mirror of evals/results/<component>.json (AGENTS.md section 5)."
      },
      "Event": {
        "properties": {
          "available_at": {
            "type": "string",
            "format": "date-time",
            "title": "Available At",
            "description": "UTC moment the record became public"
          },
          "source_ref": {
            "type": "string",
            "title": "Source Ref"
          },
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "labels": {
            "items": {
              "type": "string",
              "enum": [
                "1.01",
                "2.01",
                "2.02",
                "2.05",
                "3.02",
                "5.02",
                "5.07",
                "7.01",
                "8.01",
                "9.01",
                "other_item",
                "none"
              ]
            },
            "type": "array",
            "minItems": 1,
            "title": "Labels"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "method": {
            "type": "string",
            "enum": [
              "llm",
              "rules",
              "lexicon",
              "finbert",
              "index",
              "xbrl",
              "regex",
              "model"
            ],
